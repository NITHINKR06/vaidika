# ── VaidikaAI v3 Environment Variables ───────────────────────────
# 1. cp .env.example .env
# === PRODUCTION (RENDER / PaaS) ===
# Set DB_PATH to a persistent mount point if using PaaS
# On Render, this should match your disk mount path (e.g., /app/data/vaidika.db)
DB_PATH=/app/data/vaidika.db

# === LLM CONFIGURATION ===
# Google Gemini (Recommended for Production)
GOOGLE_API_KEY=AIza...

# Ollama (Local only, leave blank for production/Gemini)
# OLLAMA_HOST=http://localhost:11434
# 2. Fill in your actual keys

# Sarvam AI → https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_key_here

GOOGLE_API_KEY=your_gemini_key_here

# Twilio (for SMS emergency alerts) → https://twilio.com
# Leave blank to disable SMS alerts
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1234567890
EMERGENCY_ALERT_NUMBER=+919999999999

# SQLite — no change needed
DATABASE_URL=sqlite:///./vaidika.db

# Delta Lake — no change needed
DELTA_LAKE_PATH=./data/delta

# Ollama — runs locally
OLLAMA_BASE_URL=http://localhost:11434
